generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        Int     @id @default(autoincrement())
  telegramId                String @unique
  city                      String?
  lat                       Float?
  lon                       Float?
  locationKey               String?
  isActiveNotification      Boolean @default(true)
}